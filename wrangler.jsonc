{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kodcenter",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/yahoo/*",
      "/binance/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tradebot-state",
      "database_id": "047e9706-bb5b-45b1-80d0-e07f944a7bdf",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
